# =====================================================
# FREELA — Environment Variables
# Copie este arquivo para .env.local e preencha
# =====================================================

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...sua_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJ...sua_service_role_key

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Freela

# --- Z-API (WhatsApp) ---
ZAPI_INSTANCE_ID=SEU_INSTANCE_ID
ZAPI_TOKEN=SEU_TOKEN
ZAPI_CLIENT_TOKEN=SEU_CLIENT_TOKEN
ZAPI_BASE_URL=https://api.z-api.io/instances

# --- Resend (Email) ---
RESEND_API_KEY=re_...sua_key
RESEND_FROM_EMAIL=noreply@freela.app
RESEND_FROM_NAME=Freela

# --- Google Maps ---
NEXT_PUBLIC_GOOGLE_MAPS_KEY=AIza...sua_key

# --- Sentry (opcional em dev) ---
NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...sua_key

# --- Storage ---
NEXT_PUBLIC_STORAGE_BUCKET_AVATARS=avatars
NEXT_PUBLIC_STORAGE_BUCKET_OS_PHOTOS=os-photos
NEXT_PUBLIC_STORAGE_BUCKET_DOCUMENTS=documents
